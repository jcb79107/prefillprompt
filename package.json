{
    "name": "prefillprompt",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@10.12.4",
    "license": "MIT",
    "homepage": "https://prefillprompt-baer.vercel.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/jcb79107/prefillprompt.git"
    },
    "bugs": {
        "url": "https://github.com/jcb79107/prefillprompt/issues"
    },
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    },
    "scripts": {
        "build": "nuxt build --preset=vercel",
        "build:cloudflare": "nuxi cleanup && nuxt build --preset=cloudflare-module",
        "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
        "deploy:blue": "pnpm build:cloudflare && wrangler --cwd=.output versions upload --preview-alias blue",
        "deploy:preview": "pnpm build:cloudflare && wrangler --cwd=.output versions upload --preview-alias launch",
        "dev": "nuxt dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "models:update": "node scripts/update-model-catalog.mjs",
        "postinstall": "nuxt prepare",
        "preview": "wrangler --cwd=.output dev",
        "test": "node --import tsx --test test/*.test.ts",
        "typecheck": "nuxt typecheck"
    },
    "dependencies": {
        "nuxt": "^4.6.4",
        "qrcode": "^1.5.4",
        "vue": "^3.5.45"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.5.1",
        "@types/eslint": "~9.6.1",
        "@types/qrcode": "^1.5.6",
        "eslint": "^10.14.0",
        "tsx": "4.20.6",
        "typescript": "~5.8.3",
        "vue-tsc": "~2.2.12",
        "wrangler": "^4.161.0"
    }
}
